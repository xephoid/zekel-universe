# Server configuration. Copy to .env locally; production values come from
# the host's config vars. Never commit a real value.
PORT=8788

# The engine's base URL (MCP over streamable HTTP) and its bearer token.
ENGINE_URL=http://localhost:8789/mcp
ENGINE_TOKEN=

# 32-byte key used to encrypt engine host tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in development to use the built-in dev key.
SECRET_KEY=

# sqlite://path for local development, postgres://... in production.
DATABASE_URL=sqlite://dev.db

# Sender address for sign-in and its-your-turn emails.
EMAIL_FROM=noreply@example.com
