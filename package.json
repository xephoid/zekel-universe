{
  "name": "zekel-universe",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "dev": "pnpm build:packages && pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @universe/server dev",
    "dev:web": "pnpm --filter @universe/web dev",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.19.0"
}
