{
  "name": "@zekel/tokens",
  "version": "0.1.0",
  "description": "Zekel Universe's design tokens: colors, fonts, radii, shadows and motion durations, as CSS variables and a TypeScript object.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xephoid/zekel-universe.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/xephoid/zekel-universe#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
