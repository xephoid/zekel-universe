# Copy this file to .env and fill in your own values. .env is gitignored;
# never commit real values. Everything here is a placeholder.

# Bearer token the engine checks on /mcp, and the token the server sends.
# Use any long random string locally. The compose stack refuses to start
# without it.
ENGINE_TOKEN=

# Secret the server uses to encrypt engine host tokens at rest.
# Use any long random string locally. Production refuses to start without it.
SECRET_KEY=

# Server port and database. SQLite locally (a file path after the scheme),
# Postgres in production and in the compose stack:
#   DATABASE_URL=sqlite:./dev.db
#   DATABASE_URL=postgres://universe:universe@localhost:5432/universe
PORT=8788
DATABASE_URL=sqlite:./dev.db

# The address the server listens on. Leave empty: 127.0.0.1 locally, so the
# server (and the test outbox, when on) is reachable only from this machine;
# 0.0.0.0 in production. Set 0.0.0.0 only to test from another device on a
# network you trust.
HOST=

# The public origin of the site, used in sign-in links and to refuse
# requests from other sites. Locally the Vite dev server is the origin.
APP_ORIGIN=http://localhost:5173
# Extra origins allowed to reach the API, comma separated (optional).
ALLOWED_ORIGINS=

# Sign-in email. With no RESEND_API_KEY the link is printed to the server
# log instead of sent, which is how local development works.
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=

# By turns: how long a player must be away and up before the one email
# nudge goes (default ten minutes), and how often the server looks for due
# nudges (default one minute; 0 turns the timer off). Milliseconds.
TURN_NUDGE_DELAY_MS=
TURN_NUDGE_SWEEP_MS=

# Guest accounts one client address may create in 15 minutes (default 30).
# A shared address (a classroom, an office) may need more.
GUESTS_PER_IP=

# A header the hosting platform writes with each visitor's address, used for
# the per-client limits above. Leave empty locally (the connection's own
# address is used). On Render set cf-connecting-ip. Never x-forwarded-for:
# callers can write that themselves, so the server refuses it.
CLIENT_IP_HEADER=

# Engine URL when the server runs outside docker compose (inside compose it
# is http://engine:8787/mcp).
ENGINE_URL=http://localhost:8787/mcp
# Or the engine's private host:port (render.yaml sets this); the server then
# uses http://<host:port>/mcp. ENGINE_URL wins when both are set.
ENGINE_HOSTPORT=

# Password for the Postgres service in the compose stack.
POSTGRES_PASSWORD=

# Sign-in emails (comma-separated) whose accounts may open the admin page at
# /admin and edit the storefront: game pages, designers, featured games and
# updates. Empty: nobody can. Set it in the host's config, never in a file
# in the repository.
ADMIN_EMAILS=

# Sign-in with Discord and Google through Supabase: the project address
# (https://<project>.supabase.co) and its publishable key, both or neither.
# Empty: the sign-in page offers only the email link. The project must use
# asymmetric "JWT signing keys"; see docs/auth-supabase-plan.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Site analytics (PostHog). Empty POSTHOG_KEY: the page sends nothing and
# never loads PostHog. The key is the project key (phc_...); POSTHOG_HOST is
# optional and defaults to https://us.i.posthog.com. Set both in the host's
# config only. Leave them empty locally so development is not counted.
POSTHOG_KEY=
POSTHOG_HOST=
