# Copy this file to .env and fill in your own values. .env is gitignored;
# never commit real values. Everything here is a placeholder.

# Bearer token the engine checks on /mcp, and the token the server sends.
# Use any long random string locally. The compose stack refuses to start
# without it.
ENGINE_TOKEN=

# Secret the server uses to encrypt engine host tokens at rest.
# Use any long random string locally. Production refuses to start without it.
SECRET_KEY=

# Server port and database. SQLite locally (a file path after the scheme),
# Postgres in production and in the compose stack:
#   DATABASE_URL=sqlite:./dev.db
#   DATABASE_URL=postgres://universe:universe@localhost:5432/universe
PORT=8788
DATABASE_URL=sqlite:./dev.db

# The public origin of the site, used in sign-in links and to refuse
# requests from other sites. Locally the Vite dev server is the origin.
APP_ORIGIN=http://localhost:5173
# Extra origins allowed to reach the API, comma separated (optional).
ALLOWED_ORIGINS=

# Sign-in email. With no RESEND_API_KEY the link is printed to the server
# log instead of sent, which is how local development works.
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=

# By turns: how long a player must be away and up before the one email
# nudge goes (default ten minutes), and how often the server looks for due
# nudges (default one minute; 0 turns the timer off). Milliseconds.
TURN_NUDGE_DELAY_MS=
TURN_NUDGE_SWEEP_MS=

# Guest accounts one client address may create in 15 minutes (default 30).
# A shared address (a classroom, an office) may need more.
GUESTS_PER_IP=

# Engine URL when the server runs outside docker compose (inside compose it
# is http://engine:8787/mcp).
ENGINE_URL=http://localhost:8787/mcp

# Password for the Postgres service in the compose stack.
POSTGRES_PASSWORD=
